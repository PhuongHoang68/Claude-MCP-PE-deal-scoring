NODE_ENV=development
PORT=3000
SCORING_MODE=deterministic
USE_MOCK_DATA=true
REAL_DATA_SOURCE_ENABLED=false

# Claude + MCP (primary job path): spawns `npm run mcp` server and runs Claude tool loop
ANTHROPIC_API_KEY=
USE_CLAUDE_MCP_ORCHESTRATION=true
CLAUDE_MCP_TIMEOUT_MS=55000
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
MCP_SERVER_LOG_STDERR=false

# When MCP orchestration is off or fails: optional polish for reason bullets only
ENABLE_CLAUDE_NARRATIVE=false

REAL_DATA_SOURCE_NAME=opencorporates
REAL_DATA_SOURCE_BASE_URL=https://api.opencorporates.com
REAL_DATA_SOURCE_API_KEY=
